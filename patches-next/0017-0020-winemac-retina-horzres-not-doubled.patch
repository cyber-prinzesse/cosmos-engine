From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Andrii Rozhanskyi <andrey.rozhanskiy@icloud.com>
Date: Sat, 31 Oct 2026 10:51:06 +0100
Subject: [PATCH 17/29] 0020-winemac-retina-horzres-not-doubled

---
 dlls/winemac.drv/gdi.c | 7 +------
 1 file changed, 1 insertion(+), 6 deletions(-)

diff --git a/dlls/winemac.drv/gdi.c b/dlls/winemac.drv/gdi.c
index 9816fcac..05727337 100644
--- a/dlls/winemac.drv/gdi.c
+++ b/dlls/winemac.drv/gdi.c
@@ -211,15 +211,10 @@ static INT macdrv_GetDeviceCaps(PHYSDEV dev, INT cap)
     case VERTSIZE:
         ret = vert_size;
         break;
-    case HORZRES:
-    case VERTRES:
     default:
         pthread_mutex_unlock(&device_data_mutex);
         dev = GET_NEXT_PHYSDEV( dev, pGetDeviceCaps );
-        ret = dev->funcs->pGetDeviceCaps( dev, cap );
-        if ((cap == HORZRES || cap == VERTRES) && retina_on)
-            ret *= 2;
-        return ret;
+        return dev->funcs->pGetDeviceCaps( dev, cap );
     }
 
     TRACE("cap %d -> %d\n", cap, ret);
