 FONT 8, "MS Shell Dlg"
 BEGIN
     ICON "", IDC_WAITICON, 3, 3, 32, 32
-    LTEXT "The Wine configuration in %s is being updated, please wait...",
+    LTEXT "Cosmos is getting the bottle in %s ready, please wait...",
           IDC_WAITTEXT, 40, 5, 150, 40, SS_NOPREFIX | SS_EDITCONTROL
 END
 
