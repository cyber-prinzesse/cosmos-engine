Cosmos Dock icon: always load share/wine/cosmos/exeIcon.icns first.

PE icons via DrawIconEx often flatten alpha onto opaque black, so Cosmo's
transparent corners become a sharp square in the Dock. The ICNS path keeps
alpha. Also push NSApp setApplicationIconImage when setting from ICNS/PE.

diff --git a/dlls/winemac.drv/cocoa_app.m b/dlls/winemac.drv/cocoa_app.m
index 6b00a1f..2ed5514 100644
--- a/dlls/winemac.drv/cocoa_app.m
+++ b/dlls/winemac.drv/cocoa_app.m
@@ -1216,6 +1216,8 @@ - (void) setApplicationIconFromCGImageArray:(NSArray*)images
         }
 
         self.applicationIcon = nsimage;
+        /* Cosmos: synthesized applicationIcon does not push to the Dock by itself. */
+        if (nsimage) [NSApp setApplicationIconImage:nsimage];
     }
 
     - (void) handleCommandTab
@@ -2907,7 +2909,11 @@ void macdrv_set_application_icon(CFArrayRef images, CFURLRef urlRef)
         if (imageArray || ![image isValid])
             [controller setApplicationIconFromCGImageArray:imageArray];
         else
+        {
             controller.applicationIcon = image;
+            /* Cosmos: push ICNS (corner alpha intact) to the Dock immediately. */
+            if (image) [NSApp setApplicationIconImage:image];
+        }
     });
 }
 
