 {
-    char *app_name = extract_exe_name(image_path);
+    char *app_name = get_dock_name(image_path);
     if (app_name)
     {
         char *preloader_path = create_preloader_link(*wineloader_path, app_name);
@@ -724,9 +756,15 @@ static void preloader_exec( char **argv, const char *image_path, WORD machine )
      * which will show up as the icon name in the Dock.
      * When the preloader is not being used, WINEDLLPATH needs to be set correctly for
      * the loader to find ntdll.so, so don't even attempt this unless WINEDLLPATH is set.
+     * Cosmos: or unless the loader sits beside its ntdll.so. On the first start image_path is the wine binary itself,
+     * so the program named on the command line (argv[2]) gives the name.
      */
-    if (getenv("WINEDLLPATH"))
-        replace_wineloader_path_with_link( &(argv[1]), image_path );
+    if (getenv("WINEDLLPATH") || loader_beside_ntdll( argv[1] ))
+    {
+        const char *base = strrchr( image_path, '/' );
+        base = base ? base + 1 : image_path;
+        replace_wineloader_path_with_link( &(argv[1]), !strcmp( base, "wine" ) && argv[2] ? argv[2] : image_path );
+    }
