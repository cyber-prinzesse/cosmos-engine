+#ifdef __APPLE__
+/***********************************************************************
+ *           get_mac_app_name
+ *
+ * Cosmos: the name macOS should show for a new process (Dock, menu bar, app switcher), from
+ * HKCU\Software\Wine\AppDefaults\<app.exe>\Mac Driver, AppName. Read in the parent: the forked child must not talk to
+ * the server. The child passes it to the loader as WINEMACAPPNAME, which names the Dock link after it (loader.c).
+ */
+static char *get_mac_app_name( const UNICODE_STRING *image )
+{
+    static const WCHAR macdrvW[] = {'\\','M','a','c',' ','D','r','i','v','e','r',0};
+    static const WCHAR appnameW[] = {'A','p','p','N','a','m','e',0};
+    char buffer[offsetof( KEY_VALUE_PARTIAL_INFORMATION, Data[256 * sizeof(WCHAR)] )];
+    KEY_VALUE_PARTIAL_INFORMATION *info = (KEY_VALUE_PARTIAL_INFORMATION *)buffer;
+    const WCHAR *exe = image->Buffer;
+    DWORD exe_len = image->Length / sizeof(WCHAR), i, size, len;
+    UNICODE_STRING nameW;
+    OBJECT_ATTRIBUTES attr;
+    HANDLE root, key;
+    WCHAR *path;
+    char *ret = NULL;
+    int n;
+
+    for (i = exe_len; i; i--) if (exe[i - 1] == '\\' || exe[i - 1] == '/') break;
+    exe += i;
+    exe_len -= i;
+    if (!exe_len || open_hkcu_key( "Software\\Wine\\AppDefaults", &root )) return NULL;
+    if (!(path = malloc( exe_len * sizeof(WCHAR) + sizeof(macdrvW) ))) { NtClose( root ); return NULL; }
+    memcpy( path, exe, exe_len * sizeof(WCHAR) );
+    memcpy( path + exe_len, macdrvW, sizeof(macdrvW) );
+    init_unicode_string( &nameW, path );
+    InitializeObjectAttributes( &attr, &nameW, OBJ_CASE_INSENSITIVE, root, NULL );
+    /* @@ Wine registry key: HKCU\Software\Wine\AppDefaults\app.exe\Mac Driver */
+    if (!NtOpenKey( &key, KEY_QUERY_VALUE, &attr ))
+    {
+        init_unicode_string( &nameW, appnameW );
+        if (!NtQueryValueKey( key, &nameW, KeyValuePartialInformation, buffer, sizeof(buffer), &size ) &&
+            info->Type == REG_SZ && (len = info->DataLength / sizeof(WCHAR)))
+        {
+            const WCHAR *val = (const WCHAR *)info->Data;
+            while (len && !val[len - 1]) len--;
+            if (len && (ret = malloc( len * 3 + 1 )))
+            {
+                n = ntdll_wcstoumbs( val, len, ret, len * 3, FALSE );
+                ret[n > 0 ? n : 0] = 0;
+                if (!*ret) { free( ret ); ret = NULL; }
+            }
+        }
+        NtClose( key );
+    }
+    free( path );
+    NtClose( root );
+    return ret;
+}
+#endif
