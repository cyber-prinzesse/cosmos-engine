+/* Cosmos: the name a program shows in the Dock, menu bar and app switcher. WINEMACAPPNAME when it is set: spawn_process
+ * sets it from the program's Mac Driver AppName (or clears it), and whoever starts the first program may set it. Otherwise
+ * the exe name, as before. A '/' or ':' would make a different path or show as '/' in Finder, so they become spaces. */
+static char *get_dock_name(const char *image_path)
+{
+    const char *name = getenv("WINEMACAPPNAME");
+    char *ret, *p;
+
+    if (!name || !*name) return extract_exe_name(image_path);
+    ret = strdup(name);
+    for (p = ret; *p; p++) if (*p == '/' || *p == ':') *p = ' ';
+    return ret;
+}
+
+/* Cosmos: true when the loader has its ntdll.so beside it (lib/wine/<arch>-unix/wine). It then finds ntdll through the
+ * ntdll.so link create_tempdir puts next to the Dock link, so it needs no WINEDLLPATH. */
+static BOOL loader_beside_ntdll(const char *loader)
+{
+    const char *p = strrchr(loader, '/');
+    char *ntdll;
+    BOOL ret;
+
+    if (!p || asprintf(&ntdll, "%.*s/ntdll.so", (int)(p - loader), loader) < 0) return FALSE;
+    ret = !access(ntdll, R_OK);
+    free(ntdll);
+    return ret;
+}
+
