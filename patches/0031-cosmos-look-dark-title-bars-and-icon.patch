 static inline CGRect cgrect_mac_from_win(CGRect rect)
 {
diff --git a/dlls/winemac.drv/macdrv_main.c b/dlls/winemac.drv/macdrv_main.c
index eac788b..c1d5304 100644
--- a/dlls/winemac.drv/macdrv_main.c
+++ b/dlls/winemac.drv/macdrv_main.c
@@ -61,6 +61,7 @@ int gl_surface_mode = GL_SURFACE_IN_FRONT_OPAQUE;
 bool retina_enabled = false;
 bool enable_app_nap = false;
 bool no_dock_icon = false;
+int app_appearance = 0; /* Cosmos: 0 dark, 1 light, 2 follow macOS */
 
 UINT64 app_icon_callback = 0;
 UINT64 app_quit_request_callback = 0;
@@ -395,6 +396,11 @@ static void setup_options(void)
     if (!get_config_key(hkey, appkey, "NoDockIcon", buffer, sizeof(buffer)))
         no_dock_icon = IS_OPTION_TRUE(buffer[0]);
 
+    /* Cosmos: title bars and Mac dialogs are dark, like Cosmopolitan, unless "light" or "system" (follow macOS).
+     * @@ Wine registry key: HKCU\Software\Wine\Mac Driver, Appearance (also per app under AppDefaults) */
+    if (!get_config_key(hkey, appkey, "Appearance", buffer, sizeof(buffer)))
+        app_appearance = (buffer[0] == 'l' || buffer[0] == 'L') ? 1 : (buffer[0] == 's' || buffer[0] == 'S') ? 2 : 0;
+
     /* Don't use appkey.  The DPI and monitor sizes should be consistent for all
        processes in the prefix. */
     if (!get_config_key(hkey, NULL, "RetinaMode", buffer, sizeof(buffer)))
diff --git a/dlls/winemac.drv/window.c b/dlls/winemac.drv/window.c
index b8619f5..6e51b08 100644
--- a/dlls/winemac.drv/window.c
+++ b/dlls/winemac.drv/window.c
@@ -27,6 +27,9 @@
 
 #include "config.h"
 
+#include <dlfcn.h>
+#include <unistd.h>
+
 #include <IOKit/pwr_mgt/IOPMLib.h>
 #define GetCurrentThread Mac_GetCurrentThread
 #define LoadResource Mac_LoadResource
@@ -894,6 +897,27 @@ static void set_app_icon(void)
                 CFRelease(url);
             }
         }
+        else /* Cosmos: the engine's own icon, share/wine/cosmos/exeIcon.icns (winemac.so is in lib/wine/<arch>-unix) */
+        {
+            Dl_info info;
+            char *path, *p;
+            CFURLRef url;
+
+            if (dladdr(set_app_icon, &info) && info.dli_fname &&
+                (path = malloc(strlen(info.dli_fname) + sizeof("/../../../share/wine/cosmos/exeIcon.icns"))))
+            {
+                strcpy(path, info.dli_fname);
+                if ((p = strrchr(path, '/'))) *p = 0;
+                strcat(path, "/../../../share/wine/cosmos/exeIcon.icns");
+                if (!access(path, R_OK) &&
+                    (url = CFURLCreateFromFileSystemRepresentation(NULL, (UInt8*)path, strlen(path), FALSE)))
+                {
+                    macdrv_set_application_icon(NULL, url);
+                    CFRelease(url);
+                }
+                free(path);
+            }
+        }
     }
 }
 
